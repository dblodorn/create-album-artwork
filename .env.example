# dmbk GraphQL API (server-only; never prefix with NEXT_PUBLIC_).
# Defaults to production; point at a local API to develop against it.
# DMBK_GRAPHQL_API_URL=https://graphql.dmbk.network/graphql

# This app's client key, issued in dmbk-graphql-api with
# `npm run api-client -- create create-album-artwork`. Without it the
# image picker's LoRA tab shows "not set up"; everything else works.
DMBK_GRAPHQL_API_KEY=

# Google sign-in: the shared dmbk OAuth client (the same ID lora-trainer and
# dmbk-photo use; the API only accepts tokens issued to it). Public, not a
# secret. Google renders the button only on the client's authorized
# JavaScript origins: https://sleeve.dmbk.io,
# https://create-album-artwork.vercel.app and http://localhost:3000, so Vercel
# preview URLs can't sign in. Unset: the top bar shows "Sign-in unavailable".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
