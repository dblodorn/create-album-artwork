# dmbk GraphQL API (server-only; never prefix with NEXT_PUBLIC_).
# Defaults to production; point at a local API to develop against it.
# DMBK_GRAPHQL_API_URL=https://graphql.dmbk.network/graphql

# This app's client key, issued in dmbk-graphql-api with
# `npm run api-client -- create create-album-artwork`. Without it the
# image picker's LoRA tab shows "not set up"; everything else works.
DMBK_GRAPHQL_API_KEY=
